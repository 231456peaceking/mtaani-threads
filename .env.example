# Copy to .env and fill in. Never share or commit .env
PORT=3000
DARAJA_ENV=sandbox                  # sandbox | production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Public https address Safaricom can reach (ngrok). Must end with /api/mpesa/callback
DARAJA_CALLBACK_URL=https://YOUR-NGROK-LINK.ngrok-free.app/api/mpesa/callback
CALLBACK_SECRET=change-me-long-random-text
# Sandbox demo helper: if true, the site marks the payment as paid ~8s after
# Safaricom accepts the request (clearly labelled SIMULATED). Use false to rely on the real callback.
SIMULATE_CALLBACK=false
